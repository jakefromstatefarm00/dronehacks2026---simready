<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>path_recorder</name>
  <version>1.0.0</version>
  <description>
    Records the path a pilot flies on RC (cuVSLAM odometry + Sky Beta state + depth clearance), one
    recording per arm -> disarm, in a frame relative to the arming pose, ready to be replayed through
    /skybeta/setpoint/pose. Publishes nothing to /skybeta/setpoint or /fmu.
  </description>
  <maintainer email="barkjacob@gmail.com">jacob</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
