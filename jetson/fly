#!/usr/bin/env bash
# fly -- choose what the drone runs, from the Jetson's ssh, BEFORE arming. Live, never shadow.
#
#   fly hard      hardcoded 0.9 m route through the checkpoints   (upload_to_flyx_v4c_skybeta_hard.py)
#   fly best      Jolie's planner v4c, FlyX 5/5                   (upload_to_flyx_v4c_skybeta.py)
#   fly record    RC recording day: path_recorder, no autonomy at all
#   fly play      replay the latest recorded RC path (path_player, teammate package)
#   fly status    what is configured, what is running, armed or not
#
# hard / best:  refuses if armed -> swaps the stack's competitor window to that program NOW (live,
#               shadow off) -> saves the choice so the next power-on starts the same program
#               (/etc/skybeta/drone.env -> jolie_best, ~/team_ws/.boot_program -> the file) -> waits for
#               it to come up -> runs jetson/preflight.sh and prints GO / NO-GO.
#               Then: pilot arms with the switch OFF Position, flips to Position on the ground.
# record:       same, with path_recorder (publishes no setpoints: a Position flip stays with the pilot).
#
# Install once:  mkdir -p ~/bin && ln -sf ~/team_ws/jetson/fly ~/bin/fly   (re-login, or use the full path)
# Needs sudo once per call (drone.env is root-owned).
set -u
C=skybeta-stack
PKG_DIR=~/team_ws
CHOICE=$PKG_DIR/.boot_program
HARD=upload_to_flyx_v4c_skybeta_hard.py
BEST=upload_to_flyx_v4c_skybeta.py
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
say() { echo "[fly] $*"; }
in_c() { docker exec "$C" bash -ic "$*" 2>/dev/null; }
state() { in_c "timeout -s KILL 8 ros2 topic echo --once /skybeta/state" | head -1; }
set_env() {  # set_env PKG LAUNCH
  sudo -n true 2>/dev/null || sudo -v || { say "need sudo for /etc/skybeta/drone.env"; exit 1; }
  sudo cp -p /etc/skybeta/drone.env "/etc/skybeta/drone.env.before-fly-$(date +%Y%m%d-%H%M%S)"
  sudo sed -i "s/^COMPETITOR_PKG=.*/COMPETITOR_PKG=$1/; s/^COMPETITOR_LAUNCH=.*/COMPETITOR_LAUNCH=$2/" /etc/skybeta/drone.env
}
respawn() {  # respawn "<ros2 launch ...>"
  docker exec "$C" tmux respawn-pane -k -t skybeta:competitor \
    "bash -c 'source skybeta_env.sh; source /root/team_ws/install/setup.bash; exec $1'"
}
status() {
  echo "configured (next boot): $(grep -h ^COMPETITOR_PKG /etc/skybeta/drone.env | cut -d= -f2) / $(cat "$CHOICE" 2>/dev/null || echo "$HARD (default)")"
  echo "running now:            $(docker exec "$C" bash -c "ps -eo args | grep -oE '(upload_to_flyx[^ ]*\.py( --shadow)?|lib/path_recorder/recorder|lib/path_player/player)' | sed 's#.*/lib/##' | head -1" 2>/dev/null || echo "stack not running")"
  s=$(state); echo "px4/arm:                $(echo "$s" | grep -oE '"(px4_link|armed|landed|nav_state_name|local_enu)": [^,]*' | tr '\n' ' ')"
  j=$(in_c "timeout -s KILL 6 ros2 topic echo --once /jolie_flyx/status" | head -1 | grep -oE '"state": "[A-Z_]+"'); [ -n "$j" ] && echo "program state:          $j"
}

docker ps --format '{{.Names}}' | grep -qx "$C" || { say "stack container $C is not running (sudo systemctl restart skybeta-stack)"; exit 1; }
case "${1:-}" in
  hard|best|record|play) ;;
  status) status; exit 0 ;;
  *) sed -n '2,20p' "$0"; exit 2 ;;
esac

S=$(state)
case "$S" in *'"armed": true'*) say "REFUSE: the vehicle is ARMED. Disarm first."; exit 1 ;; esac
case "$S" in *'"px4_link": false'*) say "note: PX4 link is down (Pixhawk off?) -- switching anyway; power it before the preflight" ;; esac

case "$1" in
  hard|best)
    [ "$1" = hard ] && FILE=$HARD || FILE=$BEST
    [ -f "$PKG_DIR/install/jolie_best/share/jolie_best/$FILE" ] || { say "REFUSE: $FILE not installed (cd ~/team_ws && colcon build --packages-select jolie_best inside the stack)"; exit 1; }
    say "program: $FILE (LIVE, shadow off)"
    echo "$FILE" > "$CHOICE"
    set_env jolie_best jolie_best.launch.py
    respawn "ros2 launch jolie_best jolie_best.launch.py script:=$FILE"
    say "waiting for it to come up"
    for i in $(seq 1 30); do
      sleep 2
      p=$(docker exec "$C" bash -c "ps -eo args | grep -oE 'upload_to_flyx[^ ]*\.py( --shadow)?' | head -1")
      [ "$p" = "$FILE" ] && break
    done
    [ "$p" = "$FILE" ] || { say "FAIL: $FILE did not start (docker exec -it $C tmux attach -t skybeta, window competitor)"; exit 1; }
    case "$p" in *--shadow*) say "FAIL: program came up in SHADOW"; exit 1 ;; esac
    ;;
  record)
    say "program: path_recorder (records RC flights, never commands the drone)"
    set_env path_recorder path_recorder.launch.py
    respawn "ros2 launch path_recorder path_recorder.launch.py"
    sleep 8
    ;;
  play)
    [ -d "$PKG_DIR/install/path_player" ] || { say "REFUSE: path_player is not built (colcon build --packages-select path_player inside the stack)"; exit 1; }
    say "program: path_player (replays the latest recording in ~/team_ws/runs/paths; LIVE)"
    set_env path_player path_player.launch.py
    respawn "ros2 launch path_player path_player.launch.py"
    say "waiting for it to come up"
    for i in $(seq 1 20); do sleep 2; docker exec "$C" bash -c "ps -eo args | grep -q 'lib/path_player/player'" && break; done
    docker exec "$C" bash -c "ps -eo args | grep -q 'lib/path_player/player'" || { say "FAIL: path_player did not start"; exit 1; }
    ;;
esac
say "configured for this session and the next boot"
echo
if [ -x "$HERE/preflight.sh" ] || [ -f "$HERE/preflight.sh" ]; then
  sleep 4
  bash "$HERE/preflight.sh" --quick
else
  status
fi
