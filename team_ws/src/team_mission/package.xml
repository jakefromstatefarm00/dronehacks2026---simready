<?xml version="1.0"?>
<package format="3">
  <name>team_mission</name>
  <version>0.1.0</version>
  <description>
    Our replacement for competitor_example/square_mission: dormant until the pilot arms, then
    a 1 m takeoff, a trainable (RL) policy that flies slowly through checkpoints, and a slow
    landing that ends with PX4 auto-disarming. Talks only to /skybeta/state and
    /skybeta/setpoint/*. Includes the training environment (laptop only) and simulation helpers.
  </description>
  <maintainer email="barkjacob@gmail.com">Jacob</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- provided by the skybeta image (underlay). Do NOT copy them into team_ws. -->
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <!-- px4_msgs: only the SIMULATION helpers import it; it is in the skybeta image already -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
